# Example environment variables.
#
# Copy this file to `.env` in the repo root and fill in real values:  cp .env.example .env
# `.env` is gitignored and must NEVER be committed. Only this example file,
# with placeholder values, belongs in version control. See workflow/principles.md.
#
# The backend reads the root `.env` at startup and refuses to start if a required
# variable is missing. Each feature adds the variables it uses here, with a placeholder.

# Required. Shared key that protects the API: every route except /api/health needs
# `Authorization: Bearer <key>`, and the frontend asks for it once. Use a long random string.
APP_ACCESS_KEY=change-me-to-a-long-random-string

# Required. OpenAI API key, used for every OpenAI call (SQL generation, insights, ...).
OPENAI_API_KEY=your-openai-api-key
# Required. OpenAI model id. It must support Structured Outputs in the Responses API.
OPENAI_MODEL=your-model-id

# Required. Decisions API model id, for the question classification and the eval's judge.
# Today the beta only supports gpt-6-luna.
OPENAI_DECISIONS_MODEL=gpt-6-luna

# Optional. Model prices for the usage report's estimated cost: comma-separated
# model=input/output entries, in USD per million tokens. Empty means the report shows no cost.
# `npm run prices` rewrites this line in your .env with OpenAI's current Standard prices
# (https://developers.openai.com/api/docs/pricing) for OPENAI_MODEL, OPENAI_DECISIONS_MODEL
# and the models already listed. The Decisions API charges input tokens only, so its model's
# output price is 0. These are the prices on 2026-10-21.
OPENAI_PRICES=gpt-5.4-mini=0.75/4.5,gpt-6-luna=0.1/0
