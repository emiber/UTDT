{
  "name": "utdt",
  "version": "0.1.0",
  "private": true,
  "description": "POC of a Text-to-SQL chatbot: natural-language questions answered with insights, tables and charts.",
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "seed": "npm run seed -w backend",
    "eval": "npm run eval -w backend",
    "prices": "npm run prices -w backend",
    "lint": "eslint . && prettier --check . && npm run typecheck --workspaces",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
